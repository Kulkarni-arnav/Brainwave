    },

    {
      "id": "SOP-011",
      "name": "Picnic suitability",
      "category": "picnic",
      "severity": "low",
      "applies_to": {
        "activities": ["picnic"]
      },
      "rule": {
        "all": [
          {
            "field": "temperature_2m",
            "operator": ">=",
            "value": 15
          },
          {
            "field": "temperature_2m",
            "operator": "<=",
            "value": 35
          },
          {
            "field": "precipitation",
            "operator": "<=",
            "value": 1
          },
          {
            "field": "precipitation_probability",
            "operator": "<=",
            "value": 30
          },
          {
            "field": "wind_speed_10m",
            "operator": "<=",
            "value": 25
          }
        ]
      },
      "required_weather_fields": [
        "temperature_2m",
        "precipitation",
        "precipitation_probability",
        "wind_speed_10m"
      ],
      "guidance": {
        "recommendation": "The defined conditions are suitable for a picnic.",
        "reason": "Temperature, precipitation, precipitation probability, and wind all fall within the picnic conditions defined by this safety procedure."
      }
    },

