        ]
      },
      "required_weather_fields": [
        "precipitation_probability"
      ],
      "guidance": {
        "recommendation": "Outdoor travel may be affected by the high probability of precipitation.",
        "reason": "The precipitation probability meets the threshold defined by this safety procedure."
      }
    },

    {
      "id": "SOP-005",
      "name": "Strong wind during two-wheeler travel",
      "category": "two_wheeler",
      "severity": "high",
      "applies_to": {
        "activities": ["motorcycle", "scooter", "two_wheeler"]
      },
      "rule": {
        "all": [
          {
            "field": "wind_speed_10m",
            "operator": ">=",
            "value": 40
          }
        ]
      },
      "required_weather_fields": [
        "wind_speed_10m"
      ],
      "guidance": {
        "recommendation": "Avoid two-wheeler travel in these wind conditions.",
        "reason": "The wind speed meets the threshold defined by this safety procedure."
      }
    },

    {
      "id": "SOP-006",
      "name": "Severe precipitation conditions",
      "category": "severe_weather",
      "severity": "critical",
      "applies_to": {
        "activities": [
          "cycling",
          "exercise",
          "running",
          "walking",
          "hiking",
          "travel",
          "outdoor_travel",
          "picnic",
          "park_visit",
          "outdoor_activity"
        ]
      },
      "rule": {
        "all": [
          {
            "field": "precipitation",
            "operator": ">=",
            "value": 10
          },
          {
            "field": "precipitation_probability",
            "operator": ">=",
            "value": 70
          }
        ]
      },
      "required_weather_fields": [
        "precipitation",
        "precipitation_probability"
      ],
      "guidance": {
        "recommendation": "Avoid outdoor activity under these severe precipitation conditions.",
        "reason": "Both precipitation and precipitation probability meet the critical thresholds defined by this safety procedure."
      }
    },

    {
      "id": "SOP-007",
      "name": "Children during severe outdoor conditions",
      "category": "children",
      "severity": "critical",
      "applies_to": {
        "activities": ["park_visit", "outdoor_activity", "children_outdoor_activity"]
      },
      "rule": {
        "any": [
          {
            "all": [
              {
                "field": "precipitation",
                "operator": ">=",
                "value": 10
              },
              {
                "field": "precipitation_probability",
                "operator": ">=",
                "value": 70
              }
            ]
          },
          {
            "field": "temperature_2m",
            "operator": ">=",
            "value": 40
          }
        ]
      },
      "required_weather_fields": [
        "precipitation",
        "precipitation_probability",
        "temperature_2m"
      ],
      "guidance": {
        "recommendation": "Avoid taking children outdoors under these severe weather conditions.",
        "reason": "The weather meets a critical condition defined by this safety procedure."
      }
    },

