{
  "sops": [
    {
      "id": "SOP-001",
      "name": "Strong wind during cycling",
      "category": "cycling",
      "severity": "high",
      "applies_to": {
        "activities": ["cycling"]
      },
      "rule": {
        "all": [
          {
            "field": "wind_speed_10m",
            "operator": ">=",
            "value": 35
          }
        ]
      },
      "required_weather_fields": [
        "wind_speed_10m"
      ],
      "guidance": {
        "recommendation": "Avoid outdoor cycling.",
        "reason": "The wind speed meets the threshold defined by this safety procedure."
      }
    },

    {
      "id": "SOP-002",
      "name": "High UV during outdoor exercise",
      "category": "exercise",
      "severity": "moderate",
      "applies_to": {
        "activities": ["exercise", "running", "walking"]
      },
      "rule": {
        "all": [
          {
            "field": "uv_index",
            "operator": ">=",
            "value": 8
          }
        ]
      },
      "required_weather_fields": [
        "uv_index"
      ],
      "guidance": {
        "recommendation": "Avoid prolonged outdoor exercise during these conditions and use appropriate sun protection.",
        "reason": "The UV index meets the threshold defined by this safety procedure."
      }
    },

    {
      "id": "SOP-003",
      "name": "Heavy precipitation during outdoor exercise",
      "category": "exercise",
      "severity": "high",
      "applies_to": {
        "activities": ["exercise", "running", "walking"]
      },
      "rule": {
        "all": [
          {
            "field": "precipitation",
            "operator": ">=",
            "value": 5
          }
        ]
      },
      "required_weather_fields": [
        "precipitation"
      ],
      "guidance": {
        "recommendation": "Avoid outdoor exercise under these precipitation conditions.",
        "reason": "The precipitation meets the threshold defined by this safety procedure."
      }
    },

    {
      "id": "SOP-004",
      "name": "High precipitation probability during outdoor travel",
      "category": "travel",
      "severity": "moderate",
      "applies_to": {
        "activities": ["travel", "outdoor_travel"]
      },
      "rule": {
        "all": [
          {
            "field": "precipitation_probability",
